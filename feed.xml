---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:webfeeds="http://webfeeds.org/rss/1.0">
  <channel>

    <title>{{ site.title }}</title>
    <link>{{ site.url }}{{ site.baseurl }}/</link>

    <image>
      <url>https://lyrics.ohlucinda.com/apple-touch-icon.png</url>
      <title>{{ site.title }}</title>
      <link>{{ site.url }}{{ site.baseurl }}/</link>
    </image>

    <webfeeds:icon>https://lyrics.ohlucinda.com/apple-touch-icon.png</webfeeds:icon>
    <webfeeds:accentColor>#00AEEF</webfeeds:accentColor>

    {% for post in site.posts %}
<item>
  <title>{{ post.title }}</title>
  <link>{{ site.url }}{{ site.baseurl }}{{ post.url }}</link>

  <description><![CDATA[
  <img src="https://lyrics.ohlucinda.com/images/Je'm-og-b.jpg" />
  {{ post.excerpt | strip_html | strip_newlines }}
  ]]></description>

</item>
{% endfor %}

  </channel>
</rss>
